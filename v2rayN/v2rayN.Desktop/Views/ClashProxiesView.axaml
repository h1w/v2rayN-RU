<UserControl
    x:Class="v2rayN.Desktop.Views.ClashProxiesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:v2rayN.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dto="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vms:ClashProxiesViewModel"
    Design.DataContext="{x:Static dd:DesignData.ClashProxies}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:DelayColorConverter x:Key="DelayColorConverter" />
    </UserControl.Resources>

    <DockPanel Margin="2">
        <WrapPanel
            Margin="{StaticResource Margin4}"
            VerticalAlignment="Center"
            DockPanel.Dock="Top"
            Orientation="Horizontal">

            <TextBlock
                Margin="{StaticResource MarginLr8}"
                IsVisible="{Binding !IsXrayMode}"
                VerticalAlignment="Center"
                Text="{x:Static resx:ResUI.menuRulemode}" />
            <ComboBox
                x:Name="cmbRulemode"
                Width="100"
                IsVisible="{Binding !IsXrayMode}"
                Margin="{StaticResource MarginLr8}">
                <ComboBoxItem Content="{x:Static resx:ResUI.menuModeRule}" />
                <ComboBoxItem Content="{x:Static resx:ResUI.menuModeGlobal}" />
                <ComboBoxItem Content="{x:Static resx:ResUI.menuModeDirect}" />
            </ComboBox>

            <TextBlock
                Margin="{StaticResource MarginLr8}"
                IsVisible="{Binding !IsXrayMode}"
                VerticalAlignment="Center"
                Text="{x:Static resx:ResUI.TbSorting}" />
            <ComboBox
                x:Name="cmbSorting"
                Width="100"
                IsVisible="{Binding !IsXrayMode}"
                Margin="{StaticResource MarginLr8}">
                <ComboBoxItem Content="{x:Static resx:ResUI.TbSortingDelay}" />
                <ComboBoxItem Content="{x:Static resx:ResUI.TbSortingName}" />
                <ComboBoxItem Content="{x:Static resx:ResUI.TbSortingDefault}" />
            </ComboBox>

            <Button
                x:Name="menuProxiesReload"
                Margin="{StaticResource MarginLr8}"
                Classes="IconButton Success"
                ToolTip.Tip="{x:Static resx:ResUI.menuProxiesReload}">
                <Button.Content>
                    <PathIcon Data="{StaticResource SemiIconRefresh}" />
                </Button.Content>
            </Button>

            <Button
                x:Name="menuProxiesDelaytest"
                Margin="{StaticResource MarginLr8}"
                IsVisible="{Binding !IsXrayMode}"
                Classes="IconButton Success"
                ToolTip.Tip="{x:Static resx:ResUI.menuProxiesDelaytest}">
                <Button.Content>
                    <PathIcon Data="{StaticResource SemiIconBolt}" />
                </Button.Content>
            </Button>

            <TextBlock
                Margin="{StaticResource MarginLr8}"
                VerticalAlignment="Center"
                Text="{x:Static resx:ResUI.TbAutoRefresh}" />
            <ToggleSwitch
                x:Name="togAutoRefresh"
                Margin="{StaticResource MarginLr8}"
                HorizontalAlignment="Left" />
        </WrapPanel>
        <Grid>
        <Grid IsVisible="{Binding IsXrayMode}" RowDefinitions="Auto,*,Auto,Auto">
            <Grid Margin="8,4,8,8" ColumnDefinitions="*,Auto,Auto">
                <TextBox MinWidth="180" MaxWidth="420" HorizontalAlignment="Stretch"
                         PlaceholderText="{x:Static resx:ResUI.XrayProxySearch}"
                         Text="{Binding XraySearch, Mode=TwoWay}" />
                <ComboBox Grid.Column="1" Margin="8,0" MinWidth="170" SelectedIndex="{Binding XrayConnectionFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Static resx:ResUI.XrayProxyFilterAll}" />
                    <ComboBoxItem Content="{x:Static resx:ResUI.XrayProxyFilterConnected}" />
                </ComboBox>
                <Button Grid.Column="2" Content="ⓘ" ToolTip.Tip="{x:Static resx:ResUI.XrayProxyInventoryTip}" />
            </Grid>
        <DataGrid x:Name="lstXrayProxies" Classes="proxyTable" AutoGenerateColumns="False"
                  BorderThickness="0" CanUserResizeColumns="True" CanUserSortColumns="False"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20808080"
                  HeadersVisibility="Column" IsReadOnly="True" SelectionMode="Single" RowHeight="30"
                  ItemsSource="{Binding XrayProxies}" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="2*" MinWidth="200" Header="{x:Static resx:ResUI.TbSortingName}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <Grid Margin="6,0" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Details}">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Tag}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Opacity="0.65" Text="{Binding DisplayProtocol}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="2*" MinWidth="150" Header="{x:Static resx:ResUI.TbSortingHost}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <Grid Margin="6,0" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Details}">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Opacity="0.7" Text="{Binding Badge}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*" MinWidth="110" Header="{x:Static resx:ResUI.XrayProxyGroups}" SortMemberPath="Groups">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" Text="{Binding Groups}" ToolTip.Tip="{Binding Groups}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="70" MinWidth="70" Header="{x:Static resx:ResUI.XrayProxyLiveCount}" SortMemberPath="ConnectionCount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Text="{Binding ConnectionCount}" ToolTip.Tip="{Binding ConnectionCount}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="104" MinWidth="104" Header="{x:Static resx:ResUI.XrayProxyLiveUpload}" SortMemberPath="Upload">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Text="{Binding Upload}" ToolTip.Tip="{Binding Upload}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="104" MinWidth="104" Header="{x:Static resx:ResUI.XrayProxyLiveDownload}" SortMemberPath="Download">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Text="{Binding Download}" ToolTip.Tip="{Binding Download}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="112" MinWidth="112" Header="{x:Static resx:ResUI.XrayProxyUploadRate}" SortMemberPath="UploadRate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Text="{Binding UploadRate}" ToolTip.Tip="{Binding UploadRate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="112" MinWidth="112" Header="{x:Static resx:ResUI.XrayProxyDownloadRate}" SortMemberPath="DownloadRate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Text="{Binding DownloadRate}" ToolTip.Tip="{Binding DownloadRate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
            <Expander Grid.Row="2" Margin="4,6,4,0" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Header="{x:Static resx:ResUI.XrayProxyServices}">
        <DataGrid x:Name="lstXrayServiceProxies" Classes="proxyTable" AutoGenerateColumns="False"
                  BorderThickness="0" CanUserResizeColumns="True" CanUserSortColumns="False"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20808080"
                  HeadersVisibility="Column" IsReadOnly="True" SelectionMode="Single" RowHeight="30"
                  ItemsSource="{Binding XrayServiceProxies}" MaxHeight="180">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="2*" MinWidth="200" Header="{x:Static resx:ResUI.TbSortingName}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <Grid Margin="6,0" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Details}">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Tag}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Opacity="0.65" Text="{Binding DisplayProtocol}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="2*" MinWidth="150" Header="{x:Static resx:ResUI.TbSortingHost}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <Grid Margin="6,0" ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Details}">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Opacity="0.7" Text="{Binding Badge}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*" MinWidth="110" Header="{x:Static resx:ResUI.XrayProxyGroups}" SortMemberPath="Groups">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" Text="{Binding Groups}" ToolTip.Tip="{Binding Groups}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="70" MinWidth="70" Header="{x:Static resx:ResUI.XrayProxyLiveCount}" SortMemberPath="ConnectionCount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Text="{Binding ConnectionCount}" ToolTip.Tip="{Binding ConnectionCount}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="104" MinWidth="104" Header="{x:Static resx:ResUI.XrayProxyLiveUpload}" SortMemberPath="Upload">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Text="{Binding Upload}" ToolTip.Tip="{Binding Upload}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="104" MinWidth="104" Header="{x:Static resx:ResUI.XrayProxyLiveDownload}" SortMemberPath="Download">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Text="{Binding Download}" ToolTip.Tip="{Binding Download}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="112" MinWidth="112" Header="{x:Static resx:ResUI.XrayProxyUploadRate}" SortMemberPath="UploadRate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Text="{Binding UploadRate}" ToolTip.Tip="{Binding UploadRate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="112" MinWidth="112" Header="{x:Static resx:ResUI.XrayProxyDownloadRate}" SortMemberPath="DownloadRate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dto:XrayProxyRow">
                            <TextBlock Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Right" Text="{Binding DownloadRate}" ToolTip.Tip="{Binding DownloadRate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
            </Expander>
            <Expander Grid.Row="3" Margin="4,4,4,0" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Header="{x:Static resx:ResUI.XrayProxyDetails}">
                <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock Margin="8" Text="{Binding SelectedXrayProxy.Details}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Expander>
        </Grid>
        <DockPanel IsVisible="{Binding !IsXrayMode}">
            <ListBox
                x:Name="lstProxyGroups"
                DockPanel.Dock="Left"
                ItemsSource="{Binding ProxyGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Label
                            Width="160"
                            Margin="-4,-6"
                            Padding="0"
                            Theme="{DynamicResource TagLabel}">
                            <Grid Margin="{StaticResource Margin4}" RowDefinitions="1*,8,1*">
                                <DockPanel Grid.Row="0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Type}" />
                                    <TextBlock Text="{Binding Name}" />
                                </DockPanel>
                                <TextBlock Grid.Row="2" Text="{Binding Now}" />
                            </Grid>
                        </Label>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ListBox>

            <ListBox x:Name="lstProxyDetails" ItemsSource="{Binding ProxyDetails}">
                <ItemsControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="menuProxiesDelaytestPart" Header="{x:Static resx:ResUI.menuProxiesDelaytestPart}" />
                        <MenuItem
                            x:Name="menuProxiesSelectActivity"
                            Header="{x:Static resx:ResUI.menuProxiesSelectActivity}"
                            InputGesture="Enter" />
                    </ContextMenu>
                </ItemsControl.ContextMenu>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Label
                            Width="160"
                            Margin="-10,-6"
                            Padding="0"
                            Theme="{DynamicResource TagLabel}">
                            <DockPanel>
                                <Border
                                    Width="5"
                                    Margin="0,1"
                                    Background="YellowGreen"
                                    CornerRadius="4"
                                    DockPanel.Dock="Left"
                                    IsVisible="{Binding IsActive}" />
                                <Grid Margin="{StaticResource Margin4}" RowDefinitions="1*,8,1*">
                                    <TextBlock Grid.Row="0" Text="{Binding Name}" />
                                    <DockPanel Grid.Row="2">
                                        <TextBlock
                                            DockPanel.Dock="Right"
                                            Foreground="{Binding Path=Delay, Converter={StaticResource DelayColorConverter}}"
                                            Text="{Binding DelayName}" />
                                        <TextBlock Text="{Binding Type}" />
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Label>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ListBox>
        </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
